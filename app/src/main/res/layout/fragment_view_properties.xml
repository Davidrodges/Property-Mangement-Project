<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.example.propertymanagementsystem.ui.viewmodel.PropertyViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property Directory"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="16dp" />

        <!-- Caretaker Selector & Action Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCaretakerContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Caretaker"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOutline"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinnerProperties"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:spinnerMode="dropdown" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallCaretaker"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Call Caretaker"
                    app:icon="@android:drawable/ic_menu_call"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Directory Summary Content ScrollView -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvAllPropertiesSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{viewModel.allPropertiesText}"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Property: Sunset Apartments\nLocation: Nairobi\nStatus: Occupied" />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</layout>
